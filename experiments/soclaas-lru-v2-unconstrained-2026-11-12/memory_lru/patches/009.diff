+@app.post("/notes", status_code=status.HTTP_201_CREATED)
+def create_note_endpoint(note: dict) -> dict:
+    # FastAPI will validate the incoming JSON against the expected structure
+    # if we were using a Pydantic model, but here we rely on the DB layer
+    # or explicit validation if needed. However, to maintain the 422 behavior
+    # for missing fields, we should probably keep the Pydantic model for input
+    # validation but bypass it for output. 
+    # The plan says "Refactor app/db.py... Update app/main.py... FastAPI will serialize the dicts directly."
+    # To preserve the 422 validation errors for input, we must keep the Pydantic models for INPUT.
+    # The optimization is for OUTPUT (DB -> API response).
+    # So we need to import NoteCreate/NoteUpdate for input validation, but return dicts.
+    from app.models import NoteCreate, NoteUpdate
+    
+    # Re-parse to ensure validation happens
+    validated = NoteCreate(**note)
+    return create_note(validated.title, validated.body, validated.tags)
 
 
